.colorbar([style.background-color]='tab.color', *ngIf='tab.color != null')
.progressbar([style.width]='progress + "%"', *ngIf='progress != null')
.activity-indicator(*ngIf='tab.activity$|async')
.current-tab-indicator

.index(*ngIf='!config.store.terminal.hideTabIndex && hostApp.platform === Platform.macOS', cdkDragHandle) {{index + 1}}
.index(*ngIf='!config.store.terminal.hideTabIndex && hostApp.platform !== Platform.macOS') {{index + 1}}

profile-icon(
    *ngIf='config.store.terminal.showTabProfileIcon && tab.icon',
    [icon]='tab.icon',
    [color]='tab.color ?? undefined'
)

.pin-indicator(*ngIf='tab.pinned')
    i.fas.fa-thumbtack

//- The card is anchored here rather than on the host element so its template
//- can be declared in this component, where `tab` and `hoverProvider` are
//- already in scope. NgbPopover in ng-bootstrap 14 has no context input — only
//- open(context) — so binding it from the app root would have meant driving the
//- popover manually and reimplementing its open delay.
.name(
    #nameEl,
    [class.no-hover]='config.store.terminal.hideCloseButton && config.store.terminal.hideTabOptionsButton'
    cdkDrag,
    cdkDragRootElement='tab-header',
    [cdkDragData]='tab',
    (cdkDragStarted)='onTabDragStart(tab)',
    (cdkDragEnded)='onTabDragEnd()',
    [ngbPopover]='hoverProvider ? hoverCardTemplate : null',
    [autoClose]='true',
    triggers='mouseenter:mouseleave',
    [openDelay]='400',
    [closeDelay]='100',
    [placement]='hoverPlacement',
    popoverClass='tab-hover-popover',
    container='body',
) {{tab.customTitle || tab.title}}

ng-template(#hoverCardTemplate)
    tab-hover-host([tab]='tab', [provider]='hoverProvider')

.buttons
    button(*ngIf='!config.store.terminal.hideTabOptionsButton',(click)='onContextMenu($event)') !{require('../icons/tab-options.svg')}

    button(*ngIf='!config.store.terminal.hideCloseButton && !tab.effectivelyPinned',(click)='app.closeTab(tab, true)') &times;

ng-content
