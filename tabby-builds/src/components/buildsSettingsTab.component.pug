h3.mb-3(translate) Builds

.summary-bar.mb-3
    .summary-stats
        .stat
            .stat-value {{builds.length}}
            .stat-label(translate) builds
        .stat
            .stat-value([class.text-success]='processCount') {{processCount}}
            .stat-label(translate) processes
        .stat
            .stat-value {{humanBytes(memoryTotal)}}
            .stat-label(translate) memory
        .stat
            .stat-value(*ngIf='sizeTotal !== null') {{humanBytes(sizeTotal)}}
            .stat-value.measuring(*ngIf='sizeTotal === null') …
            .stat-label(translate) on disk

    .flex-fill

    .live-note(*ngIf='lastPoll')
        .live-dot(*ngIf='!scanning')
        span {{'Updated'|translate}} {{humanAgo(lastPoll)}}

    button.btn.btn-sm.btn-secondary.ms-3(
        (click)='rescan()',
        [disabled]='scanning',
        [ngbTooltip]='"Rescan"|translate'
    )
        i.fas.fa-fw.fa-arrows-rotate([class.fa-spin]='scanning')

.alert.alert-danger(*ngIf='error') {{error}}

ul.nav-tabs(ngbNav, #nav='ngbNav', [(activeId)]='activeTab')
    li(ngbNavItem='builds')
        a(ngbNavLink, draggable='false')
            i.fas.fa-fw.fa-cubes.me-2
            span(translate) Builds
            span.tab-count.ms-2 {{builds.length}}
        ng-template(ngbNavContent)
            ng-container(*ngTemplateOutlet='buildList')

    li(ngbNavItem='options')
        a(ngbNavLink, draggable='false')
            i.fas.fa-fw.fa-sliders.me-2
            span(translate) Options
        ng-template(ngbNavContent)
            ng-container(*ngTemplateOutlet='options')

div([ngbNavOutlet]='nav')

// ── The build list, filtered by kind and shown in the selected view ─────

ng-template(#buildList)
    .list-controls
        .btn-group.btn-group-sm
            button.btn.btn-secondary(
                [class.active]='filter === "all"',
                (click)='setFilter("all")'
            )
                span(translate) All
                span.tab-count.ms-2 {{builds.length}}
            button.btn.btn-secondary(
                *ngFor='let group of groups; trackBy: trackGroup',
                [class.active]='filter === group.id',
                (click)='setFilter(group.id)'
            )
                i.fas.fa-fw.me-1(class='fa-{{group.icon}}')
                span {{group.label|translate}}
                span.tab-count.ms-2 {{group.builds.length}}

        .flex-fill

        .btn-group.btn-group-sm
            button.btn.btn-secondary(
                [class.active]='view === "cards"',
                (click)='setView("cards")',
                [ngbTooltip]='"Cards"|translate'
            )
                i.fas.fa-fw.fa-layer-group
            button.btn.btn-secondary(
                [class.active]='view === "table"',
                (click)='setView("table")',
                [ngbTooltip]='"Table"|translate'
            )
                i.fas.fa-fw.fa-table-list

    // Skeletons rather than an empty page: the first scan walks three
    // directory trees and spawns a subprocess, and a page showing "0 builds"
    // for two seconds reads as broken rather than busy.
    .builds(*ngIf='scanning && !visible.length && view === "cards"')
        .build-card.skeleton(*ngFor='let n of [1, 2, 3]')
            .build-head
                .skeleton-line.w-badge
                .skeleton-line.w-name
                .flex-fill
            .skeleton-line.w-detail
            .facts
                .skeleton-line.w-fact(*ngFor='let f of [1, 2, 3, 4]')
            .skeleton-line.w-path

    .text-muted.py-4(*ngIf='!visible.length && !scanning', translate) Nothing here.

    .builds(*ngIf='view === "cards"')
        .build-card(
            *ngFor='let build of visible; trackBy: trackBuild',
            [class.current]='build.isCurrent',
            [class.running]='build.processes.length'
        )
            .build-head
                .badge(class='text-bg-{{kindClass(build)}}') {{kindLabel(build)|translate}}
                .build-name {{build.name}}
                .build-version(*ngIf='build.version') {{build.version}}
                .badge.text-bg-primary(
                    *ngIf='build.isActive',
                    [ngbTooltip]='(taskbarSupported ? "The taskbar pin launches this build" : "The build you use")|translate'
                )
                    i.fas.fa-thumbtack.me-1
                    span(translate) active
                .badge.text-bg-success(*ngIf='build.isCurrent', translate) this window
                .badge.text-bg-danger(*ngIf='build.health?.verdict === "broken"')
                    i.fas.fa-circle-exclamation.me-1
                    span(translate) will not start
                .badge.text-bg-warning(
                    *ngIf='isStale(build)',
                    [ngbTooltip]='"The checkout has moved on since this was compiled"|translate',
                    translate
                ) stale
                .flex-fill
                button.btn.btn-sm.btn-link(
                    *ngIf='build.executable',
                    (click)='launch(build)',
                    [ngbTooltip]='"Launch"|translate'
                )
                    i.fas.fa-fw.fa-play
                button.btn.btn-sm.btn-link(
                    (click)='reveal(build)',
                    [ngbTooltip]='"Reveal in file manager"|translate'
                )
                    i.fas.fa-fw.fa-folder-open
                button.btn.btn-sm.btn-link(
                    (click)='menu(build, $event)',
                    [ngbTooltip]='"More"|translate'
                )
                    i.fas.fa-fw.fa-ellipsis-vertical

            .build-detail {{build.detail|translate}}

            // Findings sit directly under the name: when a build will not
            // start, the cause is the only thing on this card worth reading.
            .finding(
                *ngFor='let finding of build.health?.findings',
                [class.error]='finding.severity === "error"'
            )
                i.fas.fa-fw.mt-1(
                    [class.fa-circle-exclamation]='finding.severity === "error"',
                    [class.fa-triangle-exclamation]='finding.severity === "warning"'
                )
                .finding-body
                    .finding-title {{finding.title}}
                    .finding-items(*ngIf='finding.items?.length')
                        code.finding-chip(*ngFor='let item of finding.items') {{item}}
                    .finding-path(*ngIf='finding.location', [ngbTooltip]='finding.location') {{shortPath(finding.location, 70)}}
                    .finding-detail {{finding.detail}}
                    .finding-hint(*ngIf='finding.hint') {{finding.hint}}
                button.btn.btn-sm.btn-outline-secondary.flex-shrink-0(
                    *ngIf='finding.fix && finding.fix !== "none"',
                    (click)='applyFix(build, finding)'
                ) {{fixLabel(finding)|translate}}

            .facts
                .fact
                    .fact-label(translate) Processes
                    .fact-value(*ngIf='build.processes.length', [ngbTooltip]='pidList(build)')
                        span.live-dot.me-1
                        | {{build.processes.length}}
                    .fact-value.muted(*ngIf='!build.processes.length', translate) not running
                .fact(*ngIf='build.processes.length')
                    .fact-label(translate) Memory
                    .fact-value {{humanBytes(memoryOf(build))}}
                .fact(*ngIf='uptimeOf(build) !== null')
                    .fact-label(translate) Up for
                    .fact-value {{humanDuration(uptimeOf(build))}}
                .fact
                    .fact-label(translate) Built
                    .fact-value([ngbTooltip]='absoluteTime(build.builtAt)') {{humanAgo(build.builtAt)}}
                .fact
                    .fact-label(translate) Size
                    .fact-value(*ngIf='build.size') {{humanBytes(build.size.bytes)}}
                        span.muted.ms-1 ({{build.size.files}} {{(build.size.files === 1 ? 'file' : 'files')|translate}})
                    .fact-value.measuring(*ngIf='!build.size && build.sizeState === "computing"', translate) measuring…
                    .fact-value.muted(*ngIf='!build.size && build.sizeState === "idle"', translate) not measured
                    .fact-value.text-danger(*ngIf='build.sizeState === "error"', translate) failed
                .fact(*ngIf='build.arch')
                    .fact-label(translate) Arch
                    .fact-value {{build.arch}}
                .fact(*ngIf='build.git?.branch')
                    .fact-label(translate) Branch
                    .fact-value {{build.git.branch}}
                .fact(*ngIf='build.git?.builtFrom')
                    .fact-label(translate) Built from
                    .fact-value.mono {{build.git.builtFrom}}
                        span.muted.ms-1(*ngIf='isStale(build)') → {{build.git.head}}
                .fact(*ngIf='build.upstreamBase')
                    .fact-label(translate) Upstream base
                    .fact-value.mono {{build.upstreamBase}}

            .build-path(
                [ngbTooltip]='pathTooltip(build)',
                tooltipClass='builds-path-tooltip',
                container='body',
                (click)='openPath(build)'
            ) {{shortPath(build.root, 90)}}
            .build-path.muted(*ngIf='build.configPath', [ngbTooltip]='build.configPath')
                | {{'Config'|translate}}: {{shortPath(build.configPath, 80)}}

            .build-actions
                button.btn.btn-sm.btn-outline-secondary(
                    *ngIf='build.processes.length && !build.isCurrent',
                    (click)='restart(build)'
                )
                    i.fas.fa-fw.fa-arrows-rotate.me-1
                    span(translate) Restart
                button.btn.btn-sm.btn-outline-secondary(
                    *ngIf='canDiagnose(build)',
                    (click)='diagnose(build)',
                    [ngbTooltip]='"Re-run the health check"|translate'
                )
                    i.fas.fa-fw.fa-stethoscope.me-1
                    span(translate) Diagnose
                button.btn.btn-sm.btn-outline-primary(
                    *ngIf='build.executable && !build.isActive',
                    (click)='makeActive(build)',
                    [ngbTooltip]='(taskbarSupported ? "Point the taskbar pin at this build" : "Use this build")|translate'
                )
                    i.fas.fa-fw.fa-thumbtack.me-1
                    span(translate) Make active
                button.btn.btn-sm.btn-outline-secondary(
                    *ngIf='build.processes.length && !build.isCurrent',
                    (click)='quit(build)'
                )
                    i.fas.fa-fw.fa-power-off.me-1
                    span(translate) Quit
                button.btn.btn-sm.btn-outline-danger(
                    (click)='delete(build)',
                    [disabled]='!!deleteBlockedReason(build)',
                    [ngbTooltip]='deleteBlockedReason(build) || ""'
                )
                    i.fas.fa-fw.fa-trash-can.me-1
                    span {{deleteLabel(build)}}

    .table-wrap(*ngIf='view === "table"')
        table.table.table-sm.builds-table
            thead
                tr
                    th.sortable([class.sorted]='sortKey === "kind"', (click)='setSort("kind")')
                        span(translate) Kind
                        i.fas.ms-1([class]='sortIcon("kind")')
                    th.sortable([class.sorted]='sortKey === "name"', (click)='setSort("name")')
                        span(translate) Build
                        i.fas.ms-1([class]='sortIcon("name")')
                    th.sortable([class.sorted]='sortKey === "version"', (click)='setSort("version")')
                        span(translate) Version
                        i.fas.ms-1([class]='sortIcon("version")')
                    th.num.sortable([class.sorted]='sortKey === "procs"', (click)='setSort("procs")')
                        span(translate) Proc
                        i.fas.ms-1([class]='sortIcon("procs")')
                    th.num.sortable([class.sorted]='sortKey === "memory"', (click)='setSort("memory")')
                        span(translate) Memory
                        i.fas.ms-1([class]='sortIcon("memory")')
                    th.num.sortable([class.sorted]='sortKey === "size"', (click)='setSort("size")')
                        span(translate) Size
                        i.fas.ms-1([class]='sortIcon("size")')
                    th.num.sortable([class.sorted]='sortKey === "files"', (click)='setSort("files")')
                        span(translate) Files
                        i.fas.ms-1([class]='sortIcon("files")')
                    th.sortable([class.sorted]='sortKey === "built"', (click)='setSort("built")')
                        span(translate) Built
                        i.fas.ms-1([class]='sortIcon("built")')
                    th.sortable([class.sorted]='sortKey === "arch"', (click)='setSort("arch")')
                        span(translate) Arch
                        i.fas.ms-1([class]='sortIcon("arch")')
                    th.sortable([class.sorted]='sortKey === "branch"', (click)='setSort("branch")')
                        span(translate) Branch
                        i.fas.ms-1([class]='sortIcon("branch")')
                    th.sortable([class.sorted]='sortKey === "builtFrom"', (click)='setSort("builtFrom")')
                        span(translate) Built from
                        i.fas.ms-1([class]='sortIcon("builtFrom")')
                    th.sortable([class.sorted]='sortKey === "path"', (click)='setSort("path")')
                        span(translate) Path
                        i.fas.ms-1([class]='sortIcon("path")')
                    th
            tbody
                ng-container(*ngIf='scanning && !visible.length')
                    tr.skeleton-row(*ngFor='let n of [1, 2, 3]')
                        td(*ngFor='let c of skeletonCells')
                            .skeleton-line([style.width.%]='c')
                tr(
                    *ngFor='let build of visible; trackBy: trackBuild',
                    [class.current]='build.isCurrent'
                )
                    td
                        .badge(class='text-bg-{{kindClass(build)}}') {{kindLabel(build)|translate}}
                    td
                        .d-flex.align-items-center.no-wrap
                            span.live-dot.me-2(*ngIf='build.processes.length')
                            span {{build.name}}
                            .badge.text-bg-primary.ms-2(*ngIf='build.isActive')
                                i.fas.fa-thumbtack.me-1
                                span(translate) active
                            .badge.text-bg-success.ms-2(*ngIf='build.isCurrent', translate) this window
                            .badge.text-bg-warning.ms-2(*ngIf='isStale(build)', translate) stale
                    td.mono {{build.version || '—'}}
                    td.num([ngbTooltip]='pidList(build)', container='body') {{build.processes.length || '—'}}
                    td.num {{build.processes.length ? humanBytes(memoryOf(build)) : '—'}}
                    td.num
                        span(*ngIf='build.size') {{humanBytes(build.size.bytes)}}
                        span.measuring(*ngIf='!build.size && build.sizeState === "computing"') …
                        span.muted(*ngIf='!build.size && build.sizeState !== "computing"') —
                    td.num {{build.size ? build.size.files : '—'}}
                    td.no-wrap([ngbTooltip]='absoluteTime(build.builtAt)', container='body') {{humanAgo(build.builtAt)}}
                    td {{build.arch || '—'}}
                    td.mono {{build.git?.branch || '—'}}
                    td.mono.no-wrap
                        span(*ngIf='build.git?.builtFrom') {{build.git.builtFrom}}
                        span.muted.ms-1(*ngIf='isStale(build)') → {{build.git.head}}
                        span.muted(*ngIf='!build.git?.builtFrom') —
                    td.path-cell(
                        [ngbTooltip]='pathTooltip(build)',
                        tooltipClass='builds-path-tooltip',
                        container='body',
                        (click)='openPath(build)'
                    )
                        span.path-text {{build.root}}
                    td.text-end.no-wrap
                        button.btn.btn-sm.btn-link(
                            *ngIf='build.executable',
                            (click)='launch(build)',
                            [ngbTooltip]='"Launch"|translate',
                            container='body'
                        )
                            i.fas.fa-fw.fa-play
                        button.btn.btn-sm.btn-link(
                            *ngIf='build.executable && !build.isActive',
                            (click)='makeActive(build)',
                            [ngbTooltip]='"Make active"|translate',
                            container='body'
                        )
                            i.fas.fa-fw.fa-thumbtack
                        button.btn.btn-sm.btn-link(
                            (click)='reveal(build)',
                            [ngbTooltip]='"Reveal in file manager"|translate',
                            container='body'
                        )
                            i.fas.fa-fw.fa-folder-open
                        button.btn.btn-sm.btn-link.text-danger(
                            (click)='delete(build)',
                            [disabled]='!!deleteBlockedReason(build)',
                            [ngbTooltip]='deleteBlockedReason(build) || deleteLabel(build)',
                            container='body'
                        )
                            i.fas.fa-fw.fa-trash-can
                        button.btn.btn-sm.btn-link(
                            (click)='menu(build, $event)',
                            [ngbTooltip]='"More"|translate',
                            container='body'
                        )
                            i.fas.fa-fw.fa-ellipsis-vertical

// ── Options ────────────────────────────────────────────────────────────

ng-template(#options)
    h4.mb-2(translate) Scanning

    .form-line
        .header
            .title(translate) Search roots
            .description(translate) One per line. Searched for source checkouts and installer files; ~ is your home directory
        textarea.form-control(
            rows='3',
            [(ngModel)]='searchRootsText',
            (ngModelChange)='saveConfiguration()',
            (blur)='rescan()',
        )

    .form-line
        .header
            .title(translate) Search depth
            .description(translate) How many directory levels below each root to look
        input.form-control(
            type='number',
            min='0',
            max='8',
            step='1',
            [(ngModel)]='config.store.builds.searchDepth',
            (ngModelChange)='saveConfiguration()',
        )

    .form-line
        .header
            .title(translate) List installer files
            .description(translate) Setup executables, .dmg and .AppImage files found under the search roots
        toggle(
            [(ngModel)]='config.store.builds.includeInstallers',
            (ngModelChange)='saveAndRescan()',
        )

    .form-line
        .header
            .title(translate) Measure size on disk
            .description(translate) Walks each build when it is discovered. Turn off if a build lives on slow storage
        toggle(
            [(ngModel)]='config.store.builds.autoSize',
            (ngModelChange)='saveConfiguration()',
        )

    h4.mt-4.mb-2(translate) Active build

    .form-line(*ngIf='taskbarSupported')
        .header
            .title(translate) Retarget the taskbar pin
            .description(translate) Making a build active repoints the pinned Tabby shortcut at it. Windows has no way to create a pin, so pin Tabby once by hand and this keeps it aimed at the right build
        toggle(
            [(ngModel)]='config.store.builds.pinToTaskbar',
            (ngModelChange)='saveConfiguration()',
        )

    .form-line(*ngIf='taskbarSupported')
        .header
            .title(translate) The pin currently launches
            .description.mono {{pinTarget || ('Tabby is not pinned to the taskbar'|translate)}}
        button.btn.btn-secondary((click)='rescan()')
            span(translate) Recheck

    h4.mt-4.mb-2(translate) New builds

    .form-line
        .header
            .title(translate) Offer to switch when a newer build appears
            .description(translate) Checks this machine for a build newer than the one running. A declined offer is never repeated for the same build
        toggle(
            [(ngModel)]='config.store.builds.watchForNewBuilds',
            (ngModelChange)='saveConfiguration()',
        )

    .form-line
        .header
            .title(translate) Check interval
            .description(translate) Milliseconds between checks. Cutting a build takes minutes, so checking often buys nothing
        input.form-control(
            type='number',
            min='30000',
            step='30000',
            [(ngModel)]='config.store.builds.watchIntervalMs',
            (ngModelChange)='saveConfiguration()',
        )

    .form-line
        .header
            .title(translate) Check now
            .description(*ngIf='newBuildResult') {{newBuildResult}}
            .description(*ngIf='!newBuildResult', translate) Look for a newer build without waiting for the timer
        .d-flex.gap-2
            button.btn.btn-secondary((click)='checkForNewBuild()')
                span(translate) Check
            button.btn.btn-primary(*ngIf='newBuildAvailable', (click)='offerNewBuild()')
                span(translate) Switch…

    h4.mt-4.mb-2(translate) Live updates

    .form-line
        .header
            .title(translate) Process refresh interval
            .description(translate) Milliseconds between process checks. Takes effect next time this page opens
        input.form-control(
            type='number',
            min='500',
            step='500',
            [(ngModel)]='config.store.builds.processPollMs',
            (ngModelChange)='saveConfiguration()',
        )

    .form-line
        .header
            .title(translate) Rescan interval
            .description(translate) Milliseconds between filesystem rescans
        input.form-control(
            type='number',
            min='5000',
            step='5000',
            [(ngModel)]='config.store.builds.rescanMs',
            (ngModelChange)='saveConfiguration()',
        )

    .form-line
        .header
            .title(translate) Pause when unfocused
            .description(translate) Stop polling while this window is in the background
        toggle(
            [(ngModel)]='config.store.builds.pauseWhenUnfocused',
            (ngModelChange)='saveConfiguration()',
        )

    h4.mt-4.mb-2(translate) Launching a source build

    .form-line
        .header
            .title(translate) Profile directory
            .description(translate) Source builds launch with an isolated profile so they never collide with the installed app. Leave empty for a scratch directory per checkout
        input.form-control(
            type='text',
            [(ngModel)]='config.store.builds.devProfileDirectory',
            (ngModelChange)='saveConfiguration()',
        )
