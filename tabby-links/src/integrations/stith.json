{
    "id": "stith",
    "name": "Stith",
    "icon": "",
    "version": 1,
    "cacheSeconds": 30,
    "settings": [
        {
            "key": "baseUrl",
            "label": "Server",
            "placeholder": "https://stith.lvh.me",
            "default": "https://stith.lvh.me",
            "description": "Where the stith dashboard is served. The same URL works from Windows and WSL, wherever the CLI itself lives.",
            "required": true
        }
    ],
    "credentials": [],
    "detectPatterns": [
        "stith://(?:session|focus)/[A-Za-z0-9-]{4,64}"
    ],
    "matchers": [
        {
            "kind": "link",
            "pattern": "^stith://(?:session|focus)/(?<id>[A-Za-z0-9-]{4,64})",
            "link": "{{settings.baseUrl}}/agent/{{id}}"
        },
        {
            "kind": "link",
            "pattern": "^https?://[^/]+/(?:s|agent|sessions|embed/s)/(?<id>[A-Za-z0-9-]{4,64})",
            "hostSetting": "baseUrl"
        },
        {
            "kind": "text",
            "pattern": "^stith://(?:session|focus)/(?<id>[A-Za-z0-9-]{4,64})",
            "link": "{{settings.baseUrl}}/agent/{{id}}",
            "suggested": true,
            "description": "Stith session links"
        }
    ],
    "fetch": [
        {
            "id": "agent",
            "type": "http",
            "method": "GET",
            "url": "{{settings.baseUrl}}/api/agents/{{id}}",
            "headers": {
                "Accept": "application/json"
            },
            "allowUntrustedCertificate": true,
            "timeoutMs": 5000
        }
    ],
    "fields": [
        {
            "key": "name",
            "label": "Session",
            "path": "/name",
            "kind": "title",
            "default": true
        },
        {
            "key": "status",
            "label": "Status",
            "path": "/status",
            "kind": "badge",
            "default": true
        },
        {
            "key": "liveness",
            "label": "Liveness",
            "path": "/liveness",
            "kind": "badge",
            "default": false
        },
        {
            "key": "project",
            "label": "Project",
            "path": "/projectName",
            "kind": "text",
            "default": true
        },
        {
            "key": "cwd",
            "label": "Directory",
            "path": "/cwd",
            "kind": "text",
            "default": false
        },
        {
            "key": "machine",
            "label": "Machine",
            "path": "/machine",
            "kind": "text",
            "default": true
        },
        {
            "key": "branch",
            "label": "Branch",
            "path": "/gitBranch",
            "kind": "text",
            "default": false
        },
        {
            "key": "jira",
            "label": "Jira",
            "path": "/jira",
            "kind": "text",
            "default": false
        },
        {
            "key": "model",
            "label": "Model",
            "path": "/model",
            "kind": "text",
            "default": false
        },
        {
            "key": "lastActivity",
            "label": "Last activity",
            "path": "/lastActivityAt",
            "kind": "text",
            "format": "relativeTime",
            "default": true
        },
        {
            "key": "error",
            "label": "Stith",
            "path": "/error",
            "kind": "badge",
            "color": "#c0392b",
            "default": true
        }
    ],
    "tabs": [
        {
            "key": "description",
            "label": "Summary",
            "kind": "body",
            "path": "/docket/description",
            "format": "markdown",
            "default": true
        }
    ],
    "html": "<!doctype html><html><head><meta charset=\"utf-8\"><style>:root{color-scheme:light dark}body{margin:0;font:12px/1.45 system-ui,-apple-system,sans-serif}.h{display:flex;align-items:center;gap:6px;font-weight:600;font-size:13px}.d{width:8px;height:8px;border-radius:50%;flex:none}.g{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;margin-top:6px}.k{opacity:.6;white-space:nowrap}.v{overflow-wrap:anywhere}</style></head><body><div class=\"h\"><span class=\"d\" id=\"dot\"></span><span id=\"name\"></span></div><div class=\"g\" id=\"g\"></div><script>var a=(window.__data||{}).agent||{};var C={active:\"#2EA043\",running:\"#2EA043\",live:\"#2EA043\",idle:\"#E0A800\",waiting:\"#E0A800\",error:\"#D03C3C\",dead:\"#D03C3C\",stale:\"#D03C3C\"};function rel(ts){if(!ts)return\"\";var d=(Date.now()-new Date(ts).getTime())/1000;if(d<60)return\"just now\";if(d<3600)return Math.floor(d/60)+\" min ago\";if(d<86400)return Math.floor(d/3600)+\" h ago\";return Math.floor(d/86400)+\" d ago\"}document.getElementById(\"name\").textContent=a.name||\"Session\";document.getElementById(\"dot\").style.background=C[String(a.status||\"\").toLowerCase()]||\"#808890\";var g=document.getElementById(\"g\");[[\"Status\",a.status],[\"Project\",a.projectName],[\"Machine\",a.machine],[\"Branch\",a.gitBranch],[\"Last activity\",rel(a.lastActivityAt)]].forEach(function(r){if(!r[1])return;var k=document.createElement(\"div\");k.className=\"k\";k.textContent=r[0];var v=document.createElement(\"div\");v.className=\"v\";v.textContent=r[1];g.appendChild(k);g.appendChild(v)});function report(){chrome.webview.postMessage({height:document.body.scrollHeight})}window.addEventListener(\"load\",report);new ResizeObserver(report).observe(document.body);document.body.addEventListener(\"click\",function(e){var el=e.target&&e.target.closest?e.target.closest(\"a\"):null;if(el){e.preventDefault();chrome.webview.postMessage({open:el.href})}});</script></body></html>"
}
